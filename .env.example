PORT=3000
PUBLIC_BASE_URL=http://127.0.0.1:3000

# MySQL Configuration
DB_HOST=127.0.0.1
DB_PORT=your database port (default: 3306)
DB_USER=your database username (default: root)
DB_PASSWORD=your database password
DB_NAME=telegram_media_db

DATABASE_URL="mysql://your database username:your database password@127.0.0.1:3306/telegram_media_db"


# Telegram Configuration
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_CHAT_ID=-your_private_channel_id